# Frontend Environment Configuration
# Copy this file to .env.local and update values for your environment

# ==================== API CONFIGURATION ====================
# Backend API URL - Must match your backend server
NEXT_PUBLIC_API_URL=http://localhost:5000

# ==================== APP METADATA ====================
NEXT_PUBLIC_APP_NAME=OJT Monitoring System
NEXT_PUBLIC_APP_VERSION=1.0.0

# ==================== ANALYTICS (OPTIONAL) ====================
# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ==================== FEATURE FLAGS ====================
# Enable/disable features in development
NEXT_PUBLIC_DEBUG_MODE=true
