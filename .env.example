# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_URL=http://localhost/ojt1
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# ============================================
# DATABASE CONFIGURATION (KEEP SECURE)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ojthub
DB_USER=root
DB_PASS=your_database_password

# PostgreSQL / Supabase settings
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=false

# ============================================
# JWT & AUTHENTICATION (KEEP SECURE)
# ============================================
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_change_in_production

# ============================================
# EMAIL & NOTIFICATION SETTINGS
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ojthub.local
MAIL_FROM_NAME="OJT Monitoring System"

# ============================================
# API KEYS & EXTERNAL SERVICES (KEEP SECURE)
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# FRONTEND & BACKEND URLS
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api

# ============================================
# SESSION & COOKIE SETTINGS
# ============================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=1440
REMEMBER_ME_LIFETIME=604800

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,xls,xlsx

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_CHANNEL=single

# ============================================
# FEATURE FLAGS (for development)
# ============================================
ENABLE_DEBUG_TOOLBAR=true
ENABLE_API_LOGGING=true
