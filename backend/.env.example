# Backend Environment Configuration
# Copy this file to .env and update values for your environment

# ==================== NODE & APP CONFIG ====================
NODE_ENV=development
PORT=5000

# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL Connection - Use this for production/hosted databases
DATABASE_URL=postgresql://user:password@localhost:5432/ojthub

# Or use individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_secure_password
DB_DATABASE=ojthub

# Enable SSL for production databases (like AWS RDS, Heroku PostgreSQL)
DB_SSL=false

# ==================== SECURITY & JWT ====================
# Generate a strong JWT secret using: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this-in-production

# ==================== CORS CONFIGURATION ====================
# Frontend URLs for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3001

# ==================== LOGGING ====================
LOG_LEVEL=debug
ENABLE_API_LOGGING=true

# ==================== EMAIL CONFIGURATION (OPTIONAL) ====================
# SMTP Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@ojt.local

# ==================== API KEYS (OPTIONAL) ====================
# Google Maps API (for coordinator office deployment feature)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google OAuth (for SSO - if implementing)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
